@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - lesson 2</title>
    <link rel="stylesheet" href="~/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <ul class="navbar-nav flex-grow-1">
        <li class="nav-item">
            <a class="nav-link text-dark btn btn-success m-1" asp-controller="Home" asp-action="Index">Главная страница</a>
        </li>
        <li class="nav-item">
            <a class="nav-link text-dark btn btn-success m-1" asp-controller="Cart" asp-action="Index">Корзина</a>
        </li>
        <li class="nav-item">
            <a class="nav-link text-dark btn btn-success m-1" asp-controller="Favorite" asp-action="Index">Избранное</a>
        </li>
    </ul>
    @RenderBody()

    <script src="~/js/jquery/dist/jquery.min.js"></script>
    <script src="~/js/bootstrap.bundle.min.js"></script>
</body>
