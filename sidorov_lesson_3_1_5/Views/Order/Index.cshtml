@model lesson_3_1_5.Models.Order?
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    Layout = "_Layout";
}

<!DOCTYPE html>

<html>
<head>
</head>
<body>
    <div>
        <h1>ОФОРМЛЕНИЕ ЗАКАЗА</h1>
        
    <div class="row justify-content-center mt-3">
    <div class="col">
        <table class="table table-borderless">
        <thead>
        <tr align="center">
            <th><h2>Информация о покупателе</h2></th>
            <th><h2>Информация о заказе</h2></th>
        </tr>
        </thead>
        <tbody>
        <tr>
        <td class="w-50 p-4">
        @{
            if (Model != null)
            {
                <p>
                    <label asp-for="UserName">Имя</label><br />
                    <input asp-for="UserName" type="text" class="w-100"/>
                </p>
                <p>
                    <label asp-for="Address">Адрес доставки</label><br />
                    <input asp-for="Address" type="text" class="w-100" />
                </p>
                <p>
                    <label asp-for="Phone">Телефон</label><br />
                    <input asp-for="Phone" type="tel" class="w-100" />
                </p>
            }
        }
        </td>
                              <td class="w-50 p-4">
                              <div class="container">
                              @{

                              if (Model != null)
                              {
                                  if (Model.Items.Count > 0)
                                  {
                                      <div class="row mb-2 font-weight-bold" style="font-size:1.2rem">
                                                    <div class="col-1 text-center">#</div>
                                                    <div class="col-2 ">Фото</div>
                                                    <div class="col-3 ">Наименование товара</div>
                                                    <div class="col-1 text-center">Цена, руб</div>
                                                    <div class="col-3 text-center">Количество, шт</div>
                                                    <div class="col-2 text-center">Стоимость, руб</div>
                                                </div>
                                      for (var i = 0; i < Model.Items.Count; i++)
                                      {
                                          var cartItem = Model.Items[i];
                                          <div class="row mb-3">
                                                        <div class="col-12">
                                                            <div class="card shadow">
                                                                <div class="row ">
                                                                    <div class="col-1 align-self-center">
                                                                        <h3 class="text-center">@(i + 1)</h3>
                                                                    </div>
                                                                    <div class="col-2 p-0 align-self-start">
                                                                        <img class="w-50 h-50" style="object-fit:cover" src="@cartItem.Product.PhotoPath" alt="@cartItem.Product.Name">
                                                                    </div>
                                                                    <div class="col-3 align-self-center">
                                                                        <h3 class="text-left">@cartItem.Product.Name</h3>
                                                                    </div>
                                                                    <div class="col-1 align-self-center">
                                                                        <h3 class="text-center">@cartItem.Product.Cost</h3>
                                                                    </div>
                                                                    <div class="col-3 align-self-center d-flex align-items-center justify-content-center">
                                                                        <h3 class="mx-2 mb-0">@cartItem.Quantity</h3>
                                                                    </div>
                                                                    <div class="col-2 align-self-center">
                                                                        <h3 class="text-danger text-center">@cartItem.Cost.ToString("c")</h3>
                                                                    </div>
                                                                </div>
                                                            </div>
                                                        </div>
                                                    </div>
                                      }

                                      <div class="row mt-3 font-weight-bold" style="font-size:1.5rem">
                                <div class="col-10 text-right">Общая стоимость заказа:</div>
                                <div class="col-2 text-center text-danger">
                                    @Model.TotalCost.ToString("c")
                                </div>
                            </div>

                                  }
                                  else
                                  {
                                      <h2>Нет товаров!</h2>
                                  }
                              }
                              else
                              {
                                  <h2>Нет товаров!</h2>
                              }
                          }
                          </div>
                              </td>
                              </tbody>
                              </table>
                              <div class="row justify-content-center">
                                  <a class="btn btn-outline-danger col-12 m-1" col-12 asp-controller="Order" asp-action="Submit" asp-route-id="@Model?.Id" asp-route-username="@Model?.UserName" asp-route-address="@Model?.Address"
                                     asp-route-phone="@Model?.Phone">Оплатить заказ</a>
                              </div>        

                              <a asp-controller="Home" asp-action="Index" class="btn btn-info col-12 m-1">Продолжить покупки</a>
                              </div>
                              </div>
    </div>
</body>
</html>